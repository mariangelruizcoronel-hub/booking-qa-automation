{
  "name": "booking-qa-mobile",
  "private": true,
  "description": "Automatización móvil (Android) con Appium + WebdriverIO + TypeScript sobre la app de demo de Sauce Labs",
  "scripts": {
    "appium:install-driver": "appium driver install uiautomator2",
    "test": "wdio run ./wdio.conf.ts",
    "typecheck": "tsc --noEmit",
    "app:download": "mkdir -p apps && curl -L -o apps/my-demo-app-rn.apk https://github.com/saucelabs/my-demo-app-rn/releases/download/v1.3.0/Android-MyDemoAppRN.1.3.0.build-244.apk"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
