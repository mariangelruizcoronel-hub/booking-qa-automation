{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@api/*": ["./src/api/*"],
      "@data/*": ["./src/data/*"],
      "@fixtures/*": ["./src/fixtures/*"]
    }
  },
  "include": ["./src/**/*.ts", "tests/**/*.ts", "features/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "mobile", ".features-gen"]
}
