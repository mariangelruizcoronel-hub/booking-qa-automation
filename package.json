{
  "name": "booking-qa-automation",
  "version": "1.0.0",
  "description": "QA Automation portfolio: Playwright + TypeScript (UI, API, BDD/Gherkin) against a public booking platform, with CI on GitHub Actions and a mobile Appium module.",
  "private": true,
  "scripts": {
    "test": "npm run bdd:gen && playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:mobile-web": "playwright test --project=mobile-web",
    "test:bdd": "npm run bdd:gen && playwright test --project=bdd",
    "bdd:gen": "bddgen",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.6.0"
  }
}
